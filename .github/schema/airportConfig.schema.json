{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "API Config Schema",
  "type": "object",
  "required": ["$schema", "version", "ICAO", "Coordinates", "Stands"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "ICAO": { "type": "string", "pattern": "[A-Z]{4}" },
    "Coordinates": {
      "type": "string",
      "pattern": "^-?\\d{1,2}\\.\\d+:-?\\d{1,3}\\.\\d+:-?\\d{4}$"
    },
    "Hoppie": {
      "type": "object",
      "description": "Gate-terminal TELEX notification. The rendered message must satisfy the character set the relay enforces: A-Z 0-9 space . , - @ / only, 1-220 characters. No lower case and no colon. Characters that could inject into the Hoppie query string (& = # %) are excluded deliberately.",
      "required": ["MessageTemplate"],
      "properties": {
        "MessageTemplate": {
          "type": "string",
          "description": "Message text. {terminal} and {briefingUrl} are substituted; every other character must already be TELEX-safe.",
          "maxLength": 200,
          "pattern": "^([A-Z0-9 .,@/-]|\\{terminal\\}|\\{briefingUrl\\})+$"
        },
        "BriefingUrl": {
          "type": "string",
          "description": "Briefing reference. Not a full link - there is no colon or lower case available - so write it as it is read out. e.g. VATS.IM/LFPGBRIEF",
          "maxLength": 60,
          "pattern": "^[A-Z0-9 .,@/-]+$"
        }
      },
      "additionalProperties": false
    },
    "Stands": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["Coordinates", "Priority"],
        "properties": {
          "Coordinates": {
            "type": "string",
            "pattern": "^-?\\d{1,2}\\.\\d+:-?\\d{1,3}\\.\\d+:-?\\d{2,3}$"
          },
          "Code": { "type": "string", "pattern": "^[A-F]{1,6}$" },
          "Priority": { "type": "integer" },
          "Block": {
            "type": "array",
            "items": { "type": "string" }
          },
          "Callsigns": {
            "type": "array",
            "items": { "type": "string" }
          },
          "Apron": {
            "type": "object",
            "required": ["Size"],
            "properties": {
              "Size": { "type": "integer", "minimum": 2, "maximum": 100 },
              "Coordinates": {
                "type": "array",
                "items": { "type": "string", "pattern": "^-?\\d{1,2}\\.\\d+:-?\\d{1,3}\\.\\d+$" },
                "minItems": 3,
                "maxItems": 10
              }
            }
          },
          "Use": { "type": "string", "pattern": "^[A,C,H,M,P]{1,5}$" },
          "Schengen": { "type": "boolean" },
          "Wingspan": { "type": "number" },
          "Countries": {
            "type": "array",
            "items": { "type": "string" }
          },
          "Remark": {
            "type": "object",
            "patternProperties": {
              "^[A-F]{1,4}$": {
                "type": "string"
              }
            }
          },
          "Terminal": {
            "type": "string",
            "description": "Terminal this stand belongs to, substituted into the Hoppie MessageTemplate. Opts the stand in to gate-terminal TELEX; stands without it are never notified. Must be TELEX-safe, so digits are allowed but lower case is not.",
            "maxLength": 10,
            "pattern": "^[A-Z0-9 .,@/-]+$"
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  }
}
